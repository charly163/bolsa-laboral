generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  POSTULANTE
  RECLUTADOR
  ADMIN
}

enum JobMode {
  PRESENCIAL
  HIBRIDO
  REMOTO
}

enum JobStatus {
  ACTIVA
  CERRADA
}

enum ApplicationStatus {
  RECIBIDA
  EN_REVISION
  INTERESADO
  FINALIZADO
}

enum VerificationStatus {
  PENDIENTE
  APROBADO
  RECHAZADO
}

enum RatingType {
  OFERTA
  PERFIL
  TRABAJO
}

enum NotificationType {
  NUEVO_MENSAJE
  NUEVA_POSTULACION
  OFERTA_APROBADA
  VERIFICACION
  CALIFICACION
}

enum PublicationType {
  OFERTA_LABORAL
  SERVICIO_PROFESIONAL
  PRODUCTO
  SOLICITUD_TRABAJO
}

// ─── Category (with subcategory support via parentId) ───

model Category {
  id        String     @id @default(cuid())
  name      String     @unique
  slug      String     @unique
  parentId  String?
  parent    Category?  @relation("SubCategories", fields: [parentId], references: [id])
  children  Category[] @relation("SubCategories")

  profiles      Profile[]
  jobs         Job[]
  jobRequests  JobRequest[]
  publications Publication[]

  createdAt DateTime @default(now())
}

// ─── User ───

model User {
  id              String    @id @default(cuid())
  name            String?
  email           String?   @unique
  emailVerified   DateTime?
  image           String?
  password        String?
  role            Role      @default(POSTULANTE)
  phone           String?
  dni             String?
  verificadoCfp   Boolean   @default(false)
  bio             String?
  location        String?
  website         String?

  profile                  Profile?
  jobsPosted               Job[]                  @relation("RecruiterJobs")
  applications             Application[]
  contactsFrom             ContactLog[]           @relation("ContactFrom")
  contactsTo               ContactLog[]           @relation("ContactTo")
  jobRequests              JobRequest[]
  verificationRequests     VerificationRequest[]  @relation("VerificationRequests")
  verificationReviews      VerificationRequest[]  @relation("VerificationReviews")
  ratingsGiven             Rating[]               @relation("RatingsGiven")
  ratingsReceived          Rating[]               @relation("RatingsReceived")
  conversationsInitiated   Conversation[]         @relation("ConversationInitiated")
  conversationsReceived    Conversation[]         @relation("ConversationReceived")
  messages                Message[]
  notifications           Notification[]
  publications            Publication[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Profile ───

model Profile {
  id     String  @id @default(cuid())
  bio    String?
  cvUrl  String?
  userId String  @unique
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Category / trade
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])
  destacado  Boolean   @default(false)

  // Company fields (for RECLUTADOR profiles)
  companyName        String?
  cuit               String?
  address            String?
  website            String?
  companyDescription String?

  skills Skill[] @relation("ProfileSkills")

  yearsExperience Int?   @default(0)
  matricula       String?
  isPublic        Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Skill ───

model Skill {
  id   String @id @default(cuid())
  name String @unique

  profiles Profile[] @relation("ProfileSkills")
  jobs     Job[]     @relation("JobSkills")
}

// ─── Job ───

model Job {
  id          String    @id @default(cuid())
  title       String
  description String
  company     String
  location    String?
  salaryRange String?
  mode        JobMode   @default(PRESENCIAL)
  status      JobStatus @default(ACTIVA)

  recruiterId String
  recruiter   User   @relation("RecruiterJobs", fields: [recruiterId], references: [id])

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  skills       Skill[]       @relation("JobSkills")
  applications Application[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Publication {
  id          String          @id @default(cuid())
  type        PublicationType
  title       String
  description String
  imageUrl    String?
  price       String?
  location    String?
  mode        JobMode         @default(PRESENCIAL)
  status      JobStatus       @default(ACTIVA)

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type, status])
  @@index([categoryId])
}

// ─── Application ───

model Application {
  id             String            @id @default(cuid())
  status         ApplicationStatus @default(RECIBIDA)
  mensajeInicial String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, jobId])
}

model JobRequest {
  id          String   @id @default(cuid())
  title       String
  description String
  location    String?
  mode        JobMode  @default(PRESENCIAL)
  status      JobStatus @default(ACTIVA)
  budget      String?
  isUrgent    Boolean  @default(false)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationRequest {
  id         String             @id @default(cuid())
  status     VerificationStatus @default(PENDIENTE)
  notes      String?
  userId     String
  user       User               @relation("VerificationRequests", fields: [userId], references: [id], onDelete: Cascade)
  reviewedById String?
  reviewedBy User?              @relation("VerificationReviews", fields: [reviewedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Rating {
  id          String     @id @default(cuid())
  score       Int
  comment     String?
  type        RatingType @default(PERFIL)

  fromUserId String
  fromUser   User   @relation("RatingsGiven", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId   String
  toUser     User   @relation("RatingsReceived", fields: [toUserId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([fromUserId, toUserId, type])
}

model Conversation {
  id            String   @id @default(cuid())
  participantAId String
  participantA   User     @relation("ConversationInitiated", fields: [participantAId], references: [id])
  participantBId String
  participantB   User     @relation("ConversationReceived", fields: [participantBId], references: [id])
  lastMessageAt  DateTime?
  archived       Boolean  @default(false)

  messages Message[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Message {
  id            String      @id @default(cuid())
  conversationId String
  conversation  Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId      String
  sender        User        @relation(fields: [senderId], references: [id], onDelete: Cascade)
  text          String
  seenAt        DateTime?

  createdAt DateTime @default(now())
}

model Notification {
  id        String          @id @default(cuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  message   String
  link      String?
  readAt    DateTime?

  createdAt DateTime @default(now())
}

// ─── ContactLog ───

model ContactLog {
  id         String  @id @default(cuid())
  fromUserId String
  fromUser   User    @relation("ContactFrom", fields: [fromUserId], references: [id])
  toUserId   String
  toUser     User    @relation("ContactTo", fields: [toUserId], references: [id])
  mensaje    String?

  createdAt DateTime @default(now())
}
